    const tangent = circuitCurve.getTangentAt(t).normalize();
    const side = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();
    const sign = random() > 0.5 ? 1 : -1;
    const offset = sign * (17 + random() * 35);
    const size = 0.65 + random() * 1.2;
    const position = p.clone().addScaledVector(side, offset);
    position.x += (random() - 0.5) * 8;
    position.z += (random() - 0.5) * 8;
    tempMatrix.compose(position.clone().add(new THREE.Vector3(0, 0.7 * size, 0)), new THREE.Quaternion(), new THREE.Vector3(size, size, size));
    trunks.setMatrixAt(i, tempMatrix);
    tempMatrix.compose(position.clone().add(new THREE.Vector3(0, 3.0 * size, 0)), new THREE.Quaternion(), new THREE.Vector3(size, size, size));
    leaves.setMatrixAt(i, tempMatrix);
  }
  trunks.castShadow = leaves.castShadow = !reducedMotion;
  trunks.receiveShadow = leaves.receiveShadow = true;
