function makeCurve() {
  const points = [
    new THREE.Vector3(-108, 0, 10),
    new THREE.Vector3(-86, 0, -14),
    new THREE.Vector3(-58, 1.2, -37),
    new THREE.Vector3(-27, 2.1, -31),
    new THREE.Vector3(2, 0.4, -7),
    new THREE.Vector3(24, 3.5, 22),
    new THREE.Vector3(52, 1.4, 34),
    new THREE.Vector3(82, 0.2, 16),
    new THREE.Vector3(105, 2.8, -18),
    new THREE.Vector3(132, 3.6, -41),
    new THREE.Vector3(161, 1.4, -37),
    new THREE.Vector3(188, 0.4, -14),
    new THREE.Vector3(216, 1.2, 13)
  ];
  circuitCurve = new THREE.CatmullRomCurve3(points, false, "catmullrom", 0.28);
  circuitCurve.arcLengthDivisions = 1200;
  circuitCurve.updateArcLengths();
}

function ribbonGeometry(width, yOffset = 0, segments = 520) {
  const positions = [];
  const normals = [];
  const uvs = [];
  const indices = [];
  for (let i = 0; i <= segments; i++) {
    const t = i / segments;
    const p = circuitCurve.getPointAt(t);
    const tangent = circuitCurve.getTangentAt(t).normalize();
    const side = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();
    const left = p.clone().addScaledVector(side, width / 2);
    const right = p.clone().addScaledVector(side, -width / 2);
    left.y += yOffset;
    right.y += yOffset;
    positions.push(left.x, left.y, left.z, right.x, right.y, right.z);
    normals.push(0, 1, 0, 0, 1, 0);
    uvs.push(0, t * 42, 1, t * 42);
    if (i < segments) {
      const a = i * 2;
      indices.push(a, a + 2, a + 1, a + 2, a + 3, a + 1);
    }
  }
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
  geometry.setAttribute("normal", new THREE.Float32BufferAttribute(normals, 3));
  geometry.setAttribute("uv", new THREE.Float32BufferAttribute(uvs, 2));
  geometry.setIndex(indices);
  geometry.computeBoundingSphere();
  return geometry;
}

function placeAlong(object, t, lateral = 0, height = 0, scale = null) {
  const p = circuitCurve.getPointAt(t);
  const tangent = circuitCurve.getTangentAt(t).normalize();
  const side = tempA.set(-tangent.z, 0, tangent.x).normalize();
  object.position.copy(p).addScaledVector(side, lateral);
  object.position.y += height;
  object.quaternion.setFromUnitVectors(X_AXIS, tangent);
  if (scale) object.scale.copy(scale);
  object.updateMatrix();
  return { p, tangent: tangent.clone(), side: side.clone() };
}

