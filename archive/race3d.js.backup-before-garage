}

function createGrandstands() {
  [0.08, 0.43, 0.86].forEach((t, idx) => {
    const p = circuitCurve.getPointAt(t);
    const tangent = circuitCurve.getTangentAt(t).normalize();
    const side = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();
    const group = new THREE.Group();
    for (let row = 0; row < 5; row++) {
      const step = new THREE.Mesh(
        new THREE.BoxGeometry(13, 0.45, 1.2),
        new THREE.MeshStandardMaterial({ color: row % 2 ? 0x343d38 : 0x59625b, roughness: 0.8 })
      );
      step.position.set(0, row * 0.55, row * 0.85);
      step.castShadow = true;
      group.add(step);
    }
    group.position.copy(p).addScaledVector(side, idx % 2 ? 17 : -18);
    group.position.y += 0.2;
    group.quaternion.setFromUnitVectors(X_AXIS, tangent);
    if (idx % 2 === 0) group.rotateY(Math.PI);
    scene.add(group);
  });
}

function createLightPoles() {
  const poleMat = new THREE.MeshStandardMaterial({ color: 0x6f7770, roughness: 0.45, metalness: 0.65 });
  const glowMat = new THREE.MeshBasicMaterial({ color: 0xe8ffd1 });
  for (let i = 0; i < 18; i++) {
    const t = 0.03 + i / 18 * 0.93;
    const p = circuitCurve.getPointAt(t);
    const tangent = circuitCurve.getTangentAt(t).normalize();
    const side = new THREE.Vector3(-tangent.z, 0, tangent.x).normalize();
    const offset = i % 2 ? 14 : -14;
    const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.12, 7, 7), poleMat);
    pole.position.copy(p).addScaledVector(side, offset);
    pole.position.y += 3.3;
    scene.add(pole);
    const lamp = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.18, 0.3), glowMat);
    lamp.position.copy(pole.position);
    lamp.position.y += 3.35;
    lamp.quaternion.setFromUnitVectors(X_AXIS, tangent);
    scene.add(lamp);
  }
}

function makeTextSprite(text, color, width = 512, height = 128, panel = true) {
  const labelCanvas = document.createElement("canvas");
  labelCanvas.width = width;
  labelCanvas.height = height;
  const ctx = labelCanvas.getContext("2d");
  if (panel) {
    ctx.fillStyle = "rgba(5, 8, 6, .82)";
    ctx.roundRect(3, 3, width - 6, height - 6, 18);
    ctx.fill();
    ctx.strokeStyle = color;
    ctx.lineWidth = 4;
    ctx.stroke();
  }
  ctx.fillStyle = color;
  ctx.font = `700 ${Math.round(height * 0.34)}px Arial, sans-serif`;
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.fillText(text, width / 2, height / 2 + 1, width - 28);
  const texture = new THREE.CanvasTexture(labelCanvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.minFilter = THREE.LinearFilter;
  const material = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false, depthWrite: false });
  const sprite = new THREE.Sprite(material);
  sprite.userData.labelCanvas = labelCanvas;
  sprite.userData.labelTexture = texture;
  return sprite;
}

function updateCarLabel(car, racer) {
  if (!car || !racer) return;
  const signature = `${racer.model}|${racer.score}`;
  if (car.userData.labelSignature === signature) return;
  car.userData.labelSignature = signature;
  const sprite = car.userData.label;
  const labelCanvas = sprite.userData.labelCanvas;
  const ctx = labelCanvas.getContext("2d");
  const color = COMPANY_META[racer.key].color;
  ctx.clearRect(0, 0, labelCanvas.width, labelCanvas.height);
  ctx.fillStyle = "rgba(5, 8, 6, .86)";
  ctx.roundRect(3, 3, labelCanvas.width - 6, labelCanvas.height - 6, 18);
  ctx.fill();
  ctx.strokeStyle = color;
  ctx.lineWidth = 4;
  ctx.stroke();
  ctx.fillStyle = color;
  ctx.font = "700 18px Arial, sans-serif";
  ctx.textAlign = "left";
  ctx.fillText(COMPANY_META[racer.key].name.toUpperCase(), 22, 28);
  ctx.textAlign = "right";
  ctx.fillText(`${Math.round(racer.score)} PACE`, labelCanvas.width - 22, 28);

  ctx.fillStyle = "#f4f6f1";
  ctx.font = "700 30px Arial, sans-serif";
  ctx.textAlign = "center";
  const modelName = racer.model.length > 30 ? `${racer.model.slice(0, 29)}…` : racer.model;
  ctx.fillText(modelName, labelCanvas.width / 2, 70, labelCanvas.width - 42);
  sprite.userData.labelTexture.needsUpdate = true;
}

function carMaterial(color, overrides = {}) {
  return new THREE.MeshStandardMaterial({
    color: new THREE.Color(color),
    roughness: 0.25,
    metalness: 0.55,
    ...overrides
  });
}

