function placeCar(car, t, lane) {
  const point = circuitCurve.getPointAt(clamp(t, 0.001, 0.995));
  const tangent = circuitCurve.getTangentAt(clamp(t, 0.001, 0.995)).normalize();
  const side = tempA.set(-tangent.z, 0, tangent.x).normalize();
  car.position.copy(point).addScaledVector(side, lane);
  car.position.y += 0.14;
  car.quaternion.setFromUnitVectors(X_AXIS, tangent);
}

function createCars() {
  COMPANY_ORDER.forEach(createCar);
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function raceClock() {
  return clamp(currentRace.progress || 0, 0, 1) * 31;
}

function resizeRenderer() {
  if (!renderer || !camera) return;
  const rect = stage.getBoundingClientRect();
  if (rect.width < 2 || rect.height < 2) return;
  renderer.setSize(rect.width, rect.height, false);
  camera.aspect = rect.width / rect.height;
  camera.updateProjectionMatrix();
}

function vec3Array(vector) { return [vector.x, vector.y, vector.z]; }
function quatArray(quaternion) { return [quaternion.x, quaternion.y, quaternion.z, quaternion.w]; }

function snapshotScene(time = elapsed) {
  const racers = Object.fromEntries((currentRace.racers || []).map((racer) => [racer.key, { ...racer }]));
  const carStates = {};
  cars.forEach((car, key) => {
    carStates[key] = {
      position: vec3Array(car.position),
      quaternion: quatArray(car.quaternion),
      visible: car.visible,
      wheels: car.userData.wheels.map((wheel) => wheel.rotation.z),
      flameVisible: car.userData.flame.visible,
      model: racers[key]?.model || "",
      score: racers[key]?.score || 0,
      active: racers[key]?.active || false
    };
  });
  return {
    time,
    cars: carStates,
    camera: { position: vec3Array(camera.position), quaternion: quatArray(camera.quaternion), fov: camera.fov },
    background: scene.background ? [scene.background.r, scene.background.g, scene.background.b] : [0, 0, 0],
    fog: scene.fog ? [scene.fog.color.r, scene.fog.color.g, scene.fog.color.b] : [0, 0, 0],
    exposure: renderer.toneMappingExposure,
    stunt: activeStunt ? {
      signature: activeStunt.signature,
      type: activeStunt.type,
      progress: activeStunt.progress,
      localProgress: activeStunt.localProgress,
      visualTime: activeStunt.visualTime,
      startT: activeStunt.startT,
      endT: activeStunt.endT,
      lane: COMPANY_META[activeStunt.company].lane,
      company: activeStunt.company,
      color: COMPANY_META[activeStunt.company].color,
      difficulty: (activeStunt.categoryScore ?? 80) / 100
    } : null
  };
}

function captureReplayFrame(dt) {
  if (!active || !running || replayState || reducedMotion || compactDevice) return;
  replayCaptureAccumulator += dt;
  const interval = 1 / REPLAY_CAPTURE_FPS;
  if (replayCaptureAccumulator < interval) return;
  replayCaptureAccumulator %= interval;
  replayBuffer.push(snapshotScene(replayWallTime));
  const cutoff = replayWallTime - REPLAY_BUFFER_SECONDS;
  while (replayBuffer.length && replayBuffer[0].time < cutoff) replayBuffer.shift();
  if (replayButton) replayButton.disabled = replayBuffer.length < MIN_REPLAY_FRAMES;
}

function applyReplayFrame(a, b = a, alpha = 0) {
  Object.entries(a.cars).forEach(([key, stateA]) => {
    const car = cars.get(key);
    const stateB = b.cars[key] || stateA;
    if (!car) return;
    car.visible = stateA.visible;
    car.position.fromArray(stateA.position).lerp(tempA.fromArray(stateB.position), alpha);
    car.quaternion.fromArray(stateA.quaternion).slerp(tempQuat.fromArray(stateB.quaternion), alpha);
    car.userData.wheels.forEach((wheel, index) => {
      const zA = stateA.wheels[index] || 0, zB = stateB.wheels[index] || zA;
      wheel.rotation.z = zA + (zB - zA) * alpha;
    });
    car.userData.flame.visible = stateA.flameVisible;
    if (stateA.model) updateCarLabel(car, { key, model: stateA.model, score: stateA.score });
  });
  camera.position.fromArray(a.camera.position).lerp(tempB.fromArray(b.camera.position), alpha);
  camera.quaternion.fromArray(a.camera.quaternion).slerp(tempQuat.fromArray(b.camera.quaternion), alpha);
  camera.fov = a.camera.fov + (b.camera.fov - a.camera.fov) * alpha;
  camera.updateProjectionMatrix();
  scene.background.setRGB(
    a.background[0] + (b.background[0] - a.background[0]) * alpha,
    a.background[1] + (b.background[1] - a.background[1]) * alpha,
    a.background[2] + (b.background[2] - a.background[2]) * alpha
  );
  if (scene.fog) scene.fog.color.setRGB(
    a.fog[0] + (b.fog[0] - a.fog[0]) * alpha,
    a.fog[1] + (b.fog[1] - a.fog[1]) * alpha,
    a.fog[2] + (b.fog[2] - a.fog[2]) * alpha
  );
  renderer.toneMappingExposure = a.exposure + (b.exposure - a.exposure) * alpha;

  const replayStunt = alpha < .5 ? a.stunt : b.stunt;
  if (replayStunt) {
    if (replayState?.stuntSignature !== replayStunt.signature) {
      stuntFramework?.show({
        type: replayStunt.type, startT: replayStunt.startT, endT: replayStunt.endT,
        lane: replayStunt.lane, color: replayStunt.color, difficulty: replayStunt.difficulty
      });
      if (replayState) replayState.stuntSignature = replayStunt.signature;
    }
    stuntFramework?.update(replayStunt.localProgress, replayStunt.visualTime);
  } else {
    stuntFramework?.hide();
    if (replayState) replayState.stuntSignature = null;
  }
}

function startReplay(reason = "LAST ACTION", seconds = 5, automatic = false) {
  if (replayState || reducedMotion || compactDevice || replayBuffer.length < MIN_REPLAY_FRAMES) return false;
  const last = replayBuffer[replayBuffer.length - 1];
  const firstAllowed = last.time - Math.min(seconds, REPLAY_BUFFER_SECONDS);
  let frames = replayBuffer.filter((frame) => frame.time >= firstAllowed);
  if (frames.length < Math.max(6, MIN_REPLAY_FRAMES - 2)) frames = replayBuffer.slice();
  if (frames.length < Math.max(6, MIN_REPLAY_FRAMES - 2)) return false;
  const liveState = snapshotScene(elapsed);
  const resume = running;
  replayState = {
    frames, liveState, resume, automatic, reason,
    firstTime: frames[0].time,
    lastTime: frames[frames.length - 1].time,
    playhead: 0, index: 0, stuntSignature: null
  };
  stage.classList.add("is-replaying");
  stage.closest(".circuit")?.classList.add("replay-active");
  if (replayOverlay) replayOverlay.hidden = false;
  if (replayReason) replayReason.textContent = reason;
  if (replayProgressBar) replayProgressBar.style.width = "0%";
  if (replayButton) { replayButton.classList.add("is-on"); replayButton.setAttribute("aria-pressed", "true"); }
  window.mgpAudio?.setReplay?.(true);
  window.dispatchEvent(new CustomEvent("mgp-replay-start", { detail: { resume, reason, automatic } }));
  applyReplayFrame(frames[0]);
  return true;
}

function restoreLiveStunt() {
  if (!activeStunt) { stuntFramework?.hide(); return; }
  stuntFramework?.show({
    type: activeStunt.type, startT: activeStunt.startT, endT: activeStunt.endT,
    lane: COMPANY_META[activeStunt.company].lane, color: COMPANY_META[activeStunt.company].color,
    difficulty: (activeStunt.categoryScore ?? 80) / 100
  });
  stuntFramework?.update(activeStunt.localProgress, activeStunt.visualTime);
}

function endReplay({ cancelled = false } = {}) {
  if (!replayState) return;
  const { liveState, resume } = replayState;
  replayState = null;
  applyReplayFrame(liveState);
  restoreLiveStunt();
  stage.classList.remove("is-replaying");
  stage.closest(".circuit")?.classList.remove("replay-active");
  if (replayOverlay) replayOverlay.hidden = true;
  if (replayButton) { replayButton.classList.remove("is-on"); replayButton.setAttribute("aria-pressed", "false"); }
  window.mgpAudio?.setReplay?.(false);
  window.dispatchEvent(new CustomEvent("mgp-replay-ended", { detail: { resume: cancelled ? false : resume, cancelled } }));
}

function updateReplay(dt) {
  if (!replayState) return;
  replayState.playhead += dt * REPLAY_RATE;
  const targetTime = replayState.firstTime + replayState.playhead;
  const duration = Math.max(.001, replayState.lastTime - replayState.firstTime);
  const progress = Math.max(0, Math.min(1, replayState.playhead / duration));
  if (replayProgressBar) replayProgressBar.style.width = `${Math.round(progress * 100)}%`;
  while (replayState.index < replayState.frames.length - 2 && replayState.frames[replayState.index + 1].time <= targetTime) replayState.index++;
  const a = replayState.frames[replayState.index];
  const b = replayState.frames[Math.min(replayState.frames.length - 1, replayState.index + 1)];
  const alpha = b.time > a.time ? Math.max(0, Math.min(1, (targetTime - a.time) / (b.time - a.time))) : 0;
  applyReplayFrame(a, b, alpha);
  if (progress >= 1) endReplay();
}

function scheduleAutoReplay(reason) {
  if (cinematicLevel !== "maximum" || reducedMotion || replayState || replayBuffer.length < MIN_REPLAY_FRAMES) return;
  clearTimeout(autoReplayTimer);
  autoReplayTimer = window.setTimeout(() => startReplay(reason, 4.5, true), 420);
}

function updateRace(payload) {
  const previousLeader = currentRace.leader;
  currentRace = payload;
  running = Boolean(payload.running);
  const activeRacers = payload.racers.filter((racer) => racer.active);
  const leaderScore = activeRacers.length ? Math.max(...activeRacers.map((racer) => racer.score)) : 0;
  const seasonPosition = 0.018 + clamp(payload.progress, 0, 1) * 0.958;

  payload.racers.forEach((racer) => {
    const car = cars.get(racer.key);
    if (!car) return;
    const wasActive = car.userData.active;
    car.userData.active = racer.active;
    const evidenceGap = Math.max(0, leaderScore - racer.score);
    car.userData.seasonT = seasonPosition;
    car.userData.targetGap = racer.active ? evidenceGap * 0.0022 : 0;
    car.userData.targetT = racer.active
      ? clamp(seasonPosition - car.userData.targetGap, 0.012, 0.976)
      : 0.012;
    car.visible = racer.active || (car.userData.boost > 0 && wasActive);
    updateCarLabel(car, racer);
    if (!wasActive && racer.active) {
      car.userData.currentGap = car.userData.targetGap + 0.028;
      car.userData.currentT = clamp(seasonPosition - car.userData.currentGap, 0.012, 0.976);
      car.userData.lastSeasonT = seasonPosition;
      car.userData.velocity = 0;
      car.userData.boost = Math.max(car.userData.boost, 1.5);
    }
    if (!running && racer.active) {
      car.userData.currentGap = car.userData.targetGap;
      car.userData.currentT = car.userData.targetT;
      car.userData.lastSeasonT = seasonPosition;
      car.userData.velocity = 0;
    }
  });

  const firstActive = payload.racers.find((r) => r.active)?.key || null;
  if (!focusCompany || !cars.get(focusCompany)?.userData.active) focusCompany = payload.leader || firstActive;
  if (!directorFocus || !cars.get(directorFocus)?.userData.active) directorFocus = payload.leader || firstActive;

  if (payload.leader && !lastLeader) {
    lastLeader = payload.leader;
    lastLeaderScore = payload.racers.find((r) => r.key === payload.leader)?.score || 0;
  } else if (payload.leader && payload.leader !== lastLeader && payload.progress > 0.015) {
    pendingLeadChange = {
      newLeader: payload.leader,
      oldLeader: lastLeader,
      detectedAt: raceClock()
    };
    lastLeader = payload.leader;
    lastLeaderScore = payload.racers.find((r) => r.key === payload.leader)?.score || 0;
  } else if (payload.leader) {
    lastLeader = payload.leader;
    lastLeaderScore = payload.racers.find((r) => r.key === payload.leader)?.score || lastLeaderScore;
  }

  if (selectedCamera === "director" && previousLeader !== payload.leader && payload.leader) directorNextSwitch = Math.min(directorNextSwitch, raceClock() + 0.18);
  updateFocusReadout();
}

function updateStuntToggleUI() {
  if (!stuntToggle) return;
  stuntToggle.classList.toggle("is-on", stuntsEnabled);
  stuntToggle.setAttribute("aria-pressed", String(stuntsEnabled));
  const status = stuntToggle.querySelector("small");
  if (status) status.textContent = stuntsEnabled ? "ON" : "OFF";
}

function setStuntsEnabled(value) {
  stuntsEnabled = Boolean(value);
  updateStuntToggleUI();
  if (!stuntsEnabled) {
    stuntQueue = [];
    endActiveStunt(false);
  } else if (active && running) {
    showDirectorBanner({ kicker: "STUNT CONTROL", headline: "RESEARCH STUNTS ENABLED", detail: "Capability milestones can now trigger visual stunts", color: "#d8ff51", duration: 2.4 });
  }
  return stuntsEnabled;
}

function toggleStunts() {
  return setStuntsEnabled(!stuntsEnabled);
}

function performStunt(company, detail = {}) {
  if (!stuntsEnabled || !detail.type || !cars.has(company)) return false;
  const signature = `${company}:${detail.modelId || detail.name}`;
  const cooldownKey = `${company}:${detail.type}`;
  if ((stuntCooldown.get(cooldownKey) || 0) > currentRace.progress) return false;
  if (activeStunt?.signature === signature || stuntQueue.some((item) => item.signature === signature)) return false;
  const categoryPriority = ["REASONING", "AGENTS", "MULTI-AGENT"].includes(detail.category) ? 74 : ["LONG CONTEXT", "CODING"].includes(detail.category) ? 68 : 62;
  stuntQueue.push({
    company,
    ...detail,
    signature,
    cooldownKey,
    priority: detail.priority || categoryPriority,
    sequence: ++stuntSequence,
    queuedAt: currentRace.progress,
    expiresAt: currentRace.progress + (detail.expiresAfterProgress || 0.18)
  });
  stuntQueue.sort((a, b) => b.priority - a.priority || a.sequence - b.sequence);
  stuntQueue = stuntQueue.slice(0, 8);
  return true;
}

function showStuntCard(stunt) {
  if (!stuntCard) return;
  const meta = COMPANY_META[stunt.company];
  stuntCard.style.setProperty("--stunt-color", meta.color);
  stuntCompany.textContent = meta.name.toUpperCase();
  stuntCategory.textContent = stunt.category || "CAPABILITY";
  stuntModel.textContent = `${stunt.model || "Current model"} · USED STUNT${stunt.resumed ? " · RESUMED" : ""}`;
  stuntName.textContent = stunt.name || "RESEARCH STUNT";
  stuntDescription.textContent = stunt.description || "A documented capability milestone is represented as a visual stunt.";
  const score = Math.round(stunt.categoryScore ?? 80);
  if (stuntPhase) stuntPhase.textContent = stunt.resumed ? "RESUMING" : "APPROACH";
  if (stuntProgressBar) stuntProgressBar.style.width = `${Math.round((stunt.progress || 0) * 100)}%`;
  if (stuntDifficulty) stuntDifficulty.textContent = `${score}`;
  if (stuntEvidence) stuntEvidence.textContent = `${stunt.rawEvidence || stunt.category || "Capability evidence"} · normalized ${score}/100`;
  if (stuntSource) stuntSource.textContent = stunt.sourceIds?.length ? `SOURCE ${stunt.sourceIds.map((id) => `#${id}`).join(" · ")}` : "RESEARCH SOURCE";
  stuntCard.hidden = false;
}

function hideStuntCard() {
  if (stuntCard) stuntCard.hidden = true;
}

function resetStuntEffects(car) {
  if (!car) return;
  if (car.userData.stuntRing) {
    car.userData.stuntRing.visible = false;
    car.userData.stuntRing.position.set(0, 0, 0);
    car.userData.stuntRing.scale.set(1, 1, 1);
  }
  if (car.userData.stuntDrones) car.userData.stuntDrones.visible = false;
  if (car.userData.stuntSmoke) car.userData.stuntSmoke.visible = false;
}

function endActiveStunt(requeue = false) {
  if (!activeStunt) return;
  const car = cars.get(activeStunt.company);
  resetStuntEffects(car);
  if (requeue && activeStunt.progress < 0.93) {
    const replay = {
      ...activeStunt,
      resumeFrom: activeStunt.progress,
      sequence: ++stuntSequence,
      queuedAt: currentRace.progress,
      expiresAt: currentRace.progress + 0.14
    };
    delete replay.startedAt;
    delete replay.startT;
    delete replay.endT;
    delete replay.pathLength;
    delete replay.progress;
    delete replay.visualTime;
    stuntQueue.unshift(replay);
  } else if (activeStunt.cooldownKey) {
    stuntCooldown.set(activeStunt.cooldownKey, currentRace.progress + 0.07);
  }
  activeStunt = null;
  releaseDirectorLock("stunt");
  stuntFramework?.hide();
  hideStuntCard();
}

function interruptStuntForPass() {
  if (activeStunt) endActiveStunt(true);
}

function startNextStunt() {
  if (!stuntsEnabled || activeStunt || activePass || finishMode || !running || !stuntQueue.length) return;
  directorLockActive();
  if (directorLock.owner && directorLock.priority > DIRECTOR_PRIORITY.stunt) return;
  stuntQueue = stuntQueue.filter((item) => item.expiresAt > currentRace.progress);
  if (!stuntQueue.length) return;
  const stunt = stuntQueue.shift();
  const car = cars.get(stunt.company);
  if (!car?.visible) return;
  const durations = { "logic-leap": 2.9, "code-drift": 2.6, "prism-roll": 3.1, "tool-swarm": 3.1, "agent-swarm": 3.4, "memory-helix": 3.2, "endurance-night": 4.0, "drag-strip": 3.0, "fuel-strategy": 3.3, "open-gate": 2.9 };
  const baseLengths = { "logic-leap": 0.072, "code-drift": 0.068, "prism-roll": 0.076, "tool-swarm": 0.082, "agent-swarm": 0.09, "memory-helix": 0.09, "endurance-night": 0.11, "drag-strip": 0.09, "fuel-strategy": 0.075, "open-gate": 0.067 };
  const difficulty = Math.max(0.25, Math.min(1, (stunt.categoryScore ?? 80) / 100));
  const resumeFrom = Math.max(0, Math.min(0.95, stunt.resumeFrom || 0));
  const fullPathLength = (baseLengths[stunt.type] || 0.07) * (0.86 + difficulty * 0.18);
  const remainingLength = Math.max(0.008, fullPathLength * (1 - resumeFrom));
  const startT = car.userData.currentT;
  const endT = Math.min(0.979, startT + remainingLength);
  activeStunt = {
    ...stunt,
    resumeFrom,
    resumed: resumeFrom > 0,
    startedAt: elapsed,
    startT,
    endT,
    pathLength: Math.max(0.0001, endT - startT),
    duration: durations[stunt.type] || 2.8,
    progress: resumeFrom,
    localProgress: 0,
    visualTime: 0,
    heroPhase: -1
  };
  stuntFramework?.show({
    type: activeStunt.type,
    startT: activeStunt.startT,
    endT: activeStunt.endT,
    resumeFrom: activeStunt.resumeFrom,
    lane: COMPANY_META[activeStunt.company].lane,
    color: COMPANY_META[activeStunt.company].color,
    difficulty
  });
  showStuntCard(activeStunt);
  directorQueue = [];
  const shotByType = { "prism-roll": "orbit", "open-gate": "front" };
  if (HERO_PHASES[activeStunt.type]) {
    updateHeroPhase(true);
  } else if (selectedCamera === "director") {
    applyDirectorTake({
      shot: shotByType[activeStunt.type] || "chase",
      focus: activeStunt.company,
      duration: activeStunt.duration,
      cut: "hard",
      kind: "stunt",
      lockPriority: DIRECTOR_PRIORITY.stunt
    }, true);
  } else {
    acquireDirectorLock("stunt", DIRECTOR_PRIORITY.stunt, activeStunt.duration);
  }
  window.mgpAudio?.stunt?.(activeStunt.company, activeStunt.type);
}

function updateHeroPhase(force = false) {
  if (!activeStunt) return;
  const phases = HERO_PHASES[activeStunt.type];
  if (!phases) return;
  let phaseIndex = 0;
  for (let i = 0; i < phases.length; i++) if (activeStunt.progress >= phases[i].at) phaseIndex = i;
  if (!force && phaseIndex === activeStunt.heroPhase) return;
  activeStunt.heroPhase = phaseIndex;
  const phase = phases[phaseIndex];
  if (stuntPhase) stuntPhase.textContent = `${activeStunt.resumed && force ? "RESUMED · " : ""}${phase.label}`;
  window.mgpAudio?.stuntPhase?.(activeStunt.company, activeStunt.type, phase.label);

  const cutIndexes = cinematicLevel === "calm" ? [0, 3] : cinematicLevel === "maximum" ? [0, 1, 2, 4] : [0, 2, 4];
  const shouldCut = force || cutIndexes.includes(phaseIndex);
  if (!shouldCut) return;
  const nextCutIndex = cutIndexes.find((index) => index > phaseIndex);
  const nextAt = nextCutIndex != null ? phases[nextCutIndex].at : 1;
  const phaseDuration = Math.max(0.45, (nextAt - activeStunt.progress) * activeStunt.duration);
  if (selectedCamera === "director") {
    applyDirectorTake({
      shot: phase.shot,
      focus: activeStunt.company,
      duration: phaseDuration,
      cut: phaseIndex % 2 ? "whip" : "hard",
      kind: "stunt",
      lockPriority: DIRECTOR_PRIORITY.stunt
    }, true);
  } else {
    acquireDirectorLock("stunt", DIRECTOR_PRIORITY.stunt, phaseDuration);
  }
}

function updateStuntLifecycle(dt) {
  if (!activeStunt) {
    startNextStunt();
    return;
  }
  const car = cars.get(activeStunt.company);
  if (!car?.visible) {
    endActiveStunt(true);
    return;
  }
  if (running) activeStunt.visualTime += dt;
  activeStunt.localProgress = Math.max(0, Math.min(1, (car.userData.currentT - activeStunt.startT) / activeStunt.pathLength));
  activeStunt.progress = activeStunt.resumeFrom + activeStunt.localProgress * (1 - activeStunt.resumeFrom);
  if (stuntProgressBar) stuntProgressBar.style.width = `${Math.round(activeStunt.progress * 100)}%`;
  updateHeroPhase(false);
  stuntFramework?.update(activeStunt.localProgress, activeStunt.visualTime);
  if (activeStunt.progress >= 0.999) {
    const replayLabel = `${activeStunt.name || activeStunt.type} · ${COMPANY_META[activeStunt.company].name}`;
    const shouldAutoReplay = cinematicLevel === "maximum" && stuntQueue.length === 0 && !activePass;
    endActiveStunt(false);
    if (shouldAutoReplay) scheduleAutoReplay(replayLabel);
    startNextStunt();
  }
}

function applyStuntTransform(car, key) {
  if (!activeStunt || activeStunt.company !== key) return;
  const p = activeStunt.progress;
  const smooth = p * p * (3 - 2 * p);
  const arc = Math.sin(Math.PI * p);
  const tangent = circuitCurve.getTangentAt(car.userData.currentT).normalize();
  const side = tempC.set(-tangent.z, 0, tangent.x).normalize();
  const ring = car.userData.stuntRing;
  const drones = car.userData.stuntDrones;
  const smoke = car.userData.stuntSmoke;
  const extension = stuntFramework?.samplePath(activeStunt.type, p) || { height: 0, lateral: 0, pitch: 0, roll: 0, yaw: 0 };
  const resumeBlend = activeStunt.resumed ? Math.max(0, Math.min(1, activeStunt.localProgress / 0.12)) : 1;
  car.position.y += extension.height * resumeBlend;
  car.position.addScaledVector(side, extension.lateral * resumeBlend);
  if (extension.pitch) car.rotateZ(extension.pitch * resumeBlend);
  if (extension.roll) car.rotateX(extension.roll * resumeBlend);
  if (extension.yaw) car.rotateY(extension.yaw * resumeBlend);

  if (activeStunt.type === "logic-leap") {
    ring.visible = true;
    ring.rotation.x = activeStunt.visualTime * 2.8;
    ring.scale.setScalar(0.75 + arc * 0.45);
  } else if (activeStunt.type === "code-drift") {
    smoke.visible = true;
    smoke.children.forEach((puff, index) => {
      puff.position.set(-2.3 - index * 0.42, 0.2 + index * 0.08, (index % 2 ? 1 : -1) * (0.55 + index * 0.08));
      puff.scale.setScalar(0.65 + arc * (0.8 + index * 0.12));
      puff.material.opacity = 0.08 + arc * 0.18;
    });
  } else if (activeStunt.type === "prism-roll") {
    ring.visible = true;
    ring.rotation.x = Math.PI * 2 * smooth;
    ring.rotation.z = activeStunt.visualTime * 3.5;
    ring.scale.setScalar(0.8 + arc * 0.8);
  } else if (["tool-swarm", "agent-swarm"].includes(activeStunt.type)) {
    drones.visible = true;
    drones.children.forEach((drone, index) => {
      const angle = activeStunt.visualTime * (activeStunt.type === "agent-swarm" ? 4.2 : 3.1) + index * Math.PI / 2;
      const split = activeStunt.type === "agent-swarm" ? Math.sin(Math.PI * p) : 1;
      const radius = (2.0 + Math.sin(activeStunt.visualTime * 2 + index) * 0.25) * split;
      drone.position.set(Math.cos(angle) * radius, 1.5 + Math.sin(angle * 2) * 0.45 * split, Math.sin(angle) * radius);
      drone.rotation.x += 0.08;
      drone.rotation.y += 0.11;
    });
  } else if (activeStunt.type === "memory-helix") {
    ring.visible = true;
    ring.rotation.x = activeStunt.visualTime * 4;
    ring.rotation.z = Math.PI * 2 * smooth;
    ring.scale.setScalar(0.65 + arc * 1.05);
  } else if (activeStunt.type === "open-gate") {
    ring.visible = true;
    ring.position.x = 4.8 - p * 8.5;
    ring.rotation.y = Math.PI / 2;
    ring.rotation.z = activeStunt.visualTime * 1.4;
    ring.scale.setScalar(1.1 + arc * 0.55);
  } else if (activeStunt.type === "endurance-night") {
    car.userData.flame.visible = p < 0.18 || p > 0.82;
  } else if (activeStunt.type === "drag-strip") {
    car.userData.flame.visible = p > 0.08 && p < 0.78;
    car.userData.flame.scale.x = 0.9 + Math.sin(activeStunt.visualTime * 36) * 0.22;
  } else if (activeStunt.type === "fuel-strategy") {
    car.userData.flame.visible = p > 0.72;
  }
}

function updateAdvancedWorldEffects(dt) {
  const targetDarkness = activeStunt?.type === "endurance-night" ? Math.sin(Math.PI * activeStunt.localProgress) * 0.94 : 0;
  worldDarkness += (targetDarkness - worldDarkness) * (1 - Math.exp(-dt * 4.2));
  scene.background.copy(dayWorldColor).lerp(nightWorldColor, worldDarkness);
  scene.fog.color.copy(dayWorldColor).lerp(nightWorldColor, worldDarkness);
  renderer.toneMappingExposure = 1.12 - worldDarkness * 0.42;
  cars.forEach((car) => {
    if (car.userData.boostLight && car.userData.boost <= 0) car.userData.boostLight.intensity = activeStunt?.type === "endurance-night" && car.userData.active ? worldDarkness * 4.5 : 0;
  });
}

function updateCars(dt) {
  updateStuntLifecycle(dt);
  cars.forEach((car, key) => {
    if (!car.userData.active && car.userData.boost <= 0) {
      car.visible = false;
      return;
    }
    car.visible = true;
    const previousT = car.userData.currentT;
    const baseAdvance = Math.max(0, car.userData.seasonT - car.userData.lastSeasonT);
    car.userData.lastSeasonT = car.userData.seasonT;
    const forwardCorrection = Math.max(0, car.userData.targetT - car.userData.currentT);
    const catchupRate = reducedMotion ? 18 : 6.2;
    const catchupAdvance = forwardCorrection * (1 - Math.exp(-catchupRate * dt));
    const minimumForward = baseAdvance * 0.74;
    const advance = running ? Math.max(minimumForward, catchupAdvance) : 0;
    car.userData.currentT = clamp(previousT + Math.max(0, advance), 0.008, 0.982);
    car.userData.currentGap = Math.max(0, car.userData.seasonT - car.userData.currentT);
    const step = car.userData.currentT - previousT;
    car.userData.velocity = dt > 0 ? step / dt : 0;
    placeCar(car, car.userData.currentT, COMPANY_META[key].lane);

    const wheelSpeed = Math.abs(step) * 880 + (running ? 2.2 * dt : 0);
    car.userData.wheels.forEach((wheel) => { wheel.rotation.z -= wheelSpeed; });
    car.userData.boost = Math.max(0, car.userData.boost - dt);
    const boosting = car.userData.boost > 0;
    car.userData.flame.visible = boosting;
    car.userData.flame.scale.x = boosting ? 0.65 + Math.sin(elapsed * 42) * 0.22 : 0.1;
    car.userData.boostLight.intensity = boosting ? 10 + Math.sin(elapsed * 30) * 3 : 0;

    const bob = running ? Math.sin(elapsed * 15 + COMPANY_ORDER.indexOf(key)) * 0.025 : 0;
    car.position.y += bob;
    applyStuntTransform(car, key);
  });
  updateAdvancedWorldEffects(dt);
  updatePhysicalLeaderHud();
  updatePredictivePass();
}

function updatePhysicalLeaderHud() {
  const leaderNode = document.getElementById("raceLeader");
  if (!leaderNode) return;
  const physicalOrder = [...cars.entries()]
    .filter(([, car]) => car.userData.active && car.visible)
    .sort((a, b) => b[1].userData.currentT - a[1].userData.currentT || (racerInfo(b[0])?.score || 0) - (racerInfo(a[0])?.score || 0));
  physicalLeaderKey = physicalOrder.length ? physicalOrder[0][0] : null;
  leaderNode.textContent = physicalLeaderKey ? COMPANY_META[physicalLeaderKey].name.toUpperCase() : "IN THE PITS";
}

function racerInfo(key) {
  return currentRace.racers?.find((racer) => racer.key === key) || null;
}

function completePass(pass, position) {
  const passer = racerInfo(pass.passer);
  const target = racerInfo(pass.target);
  directorQueue = [];
  applyDirectorTake({
    shot: position === 1 ? "front" : "chase",
    focus: pass.passer,
    secondary: pass.target,
    duration: 2.55,
    cut: "hard",
    kind: "pass-complete",
    kicker: position === 1 ? "NEW RACE LEADER" : "PASS COMPLETE",
    headline: `${passer?.name || COMPANY_META[pass.passer].name} TAKES P${position}`,
    detail: `${passer?.model || "The attacking model"} moves ahead of ${target?.name || COMPANY_META[pass.target].name}`
  }, true);
  passCooldown.set(`${pass.passer}>${pass.target}`, raceClock() + 4.5);
  if (position === 1 && pendingLeadChange?.newLeader === pass.passer) pendingLeadChange = null;
  activePass = null;
  scheduleAutoReplay(`OVERTAKE · ${passer?.name || COMPANY_META[pass.passer].name} TAKES P${position}`);
}

function updatePredictivePass() {
  if (!active || !running || finishMode || selectedCamera !== "director") return;

  if (activePass) {
    const passerCar = cars.get(activePass.passer);
    const targetCar = cars.get(activePass.target);
    if (!passerCar?.visible || !targetCar?.visible) {
      activePass = null;
      releaseDirectorLock("pass");
      return;
    }
    const gap = targetCar.userData.currentT - passerCar.userData.currentT;
    if (activePass.phase === "approach" && gap <= 0.014 && gap > 0.0007) {
      activePass.phase = "side-by-side";
      const passer = racerInfo(activePass.passer);
      const target = racerInfo(activePass.target);
      applyDirectorTake({
        shot: "battle",
        focus: activePass.passer,
        secondary: activePass.target,
        duration: 1.85,
        cut: "whip",
        kind: "pass-battle",
        kicker: `BATTLE FOR P${activePass.position}`,
        headline: `${passer?.name || COMPANY_META[activePass.passer].name} GOES SIDE BY SIDE`,
        detail: `${passer?.model || "Attacker"} alongside ${target?.model || "the car ahead"}`
      }, true);
    }
    if (gap <= 0.0007) {
      completePass(activePass, activePass.position);
      return;
    }
    if (raceClock() - activePass.startedAt > 6.5) {
      passCooldown.set(`${activePass.passer}>${activePass.target}`, raceClock() + 2.5);
      activePass = null;
      releaseDirectorLock("pass");
    }
    return;
  }

  if (pendingLeadChange) {
    const newCar = cars.get(pendingLeadChange.newLeader);
    const oldCar = cars.get(pendingLeadChange.oldLeader);
    if (newCar?.visible && oldCar?.visible && newCar.userData.currentT >= oldCar.userData.currentT - 0.0007) {
      interruptStuntForPass();
      completePass({ passer: pendingLeadChange.newLeader, target: pendingLeadChange.oldLeader }, 1);
      return;
    }
  }

  const desiredOrder = (currentRace.racers || [])
    .filter((racer) => racer.active)
    .sort((a, b) => b.score - a.score || COMPANY_ORDER.indexOf(a.key) - COMPANY_ORDER.indexOf(b.key));
  let candidate = null;
  for (let desiredIndex = 0; desiredIndex < desiredOrder.length; desiredIndex++) {
    const passer = desiredOrder[desiredIndex];
    const passerCar = cars.get(passer.key);
    if (!passerCar?.visible) continue;
    for (let targetIndex = desiredIndex + 1; targetIndex < desiredOrder.length; targetIndex++) {
      const target = desiredOrder[targetIndex];
      const targetCar = cars.get(target.key);
      if (!targetCar?.visible || passer.score <= target.score + 0.2) continue;
      const physicalGap = targetCar.userData.currentT - passerCar.userData.currentT;
      const certainByTarget = passerCar.userData.targetT > targetCar.userData.targetT + 0.0005;
      const relativeSpeed = passerCar.userData.velocity - targetCar.userData.velocity;
      const eta = relativeSpeed > 0.0001 ? physicalGap / relativeSpeed : Infinity;
      const key = `${passer.key}>${target.key}`;
      if (physicalGap > 0.0007 && certainByTarget && (eta < 3.2 || physicalGap < 0.045) && (passCooldown.get(key) || 0) <= raceClock()) {
        const option = { passer, target, physicalGap, eta, position: desiredIndex + 1, key };
        if (!candidate || option.position < candidate.position || (option.position === candidate.position && option.physicalGap < candidate.physicalGap)) candidate = option;
      }
    }
  }
  if (!candidate) return;

  interruptStuntForPass();
  activePass = {
    passer: candidate.passer.key,
    target: candidate.target.key,
    position: candidate.position,
    phase: "approach",
    startedAt: raceClock()
  };
  directorQueue = [];
  applyDirectorTake({
    shot: "chase",
    focus: candidate.passer.key,
    secondary: candidate.target.key,
    duration: 1.55,
    cut: "hard",
    kind: "predicted-pass",
    kicker: `OVERTAKE PREDICTED · P${candidate.position}`,
    headline: `${candidate.passer.name} IS CLOSING FAST`,
    detail: `${candidate.passer.model} has the pace to pass ${candidate.target.name}${Number.isFinite(candidate.eta) ? ` · ETA ${candidate.eta.toFixed(1)}s` : ""}`
  }, true);
}

function activeFocusCar() {
  const requested = selectedCamera === "director" ? directorFocus : focusCompany;
  const preferred = cars.get(requested);
  if (preferred?.visible) return preferred;
  const leader = cars.get(currentRace.leader);
  if (leader?.visible) return leader;
  return [...cars.values()].find((car) => car.visible) || null;
}

function activeSecondaryCar(primary) {
  const requested = selectedCamera === "director" ? directorSecondary : null;
  const explicit = cars.get(requested);
  if (explicit?.visible && explicit !== primary) return explicit;
  const activeCars = [...cars.values()].filter((car) => car.visible && car !== primary)
    .sort((a, b) => Math.abs(a.userData.currentT - primary.userData.currentT) - Math.abs(b.userData.currentT - primary.userData.currentT));
  return activeCars[0] || null;
}

function triggerCameraCut(kind = "hard") {
  if (!cameraCutLayer || reducedMotion) return;
  cameraCutLayer.classList.remove("is-cut", "is-whip");
  void cameraCutLayer.offsetWidth;
  cameraCutLayer.classList.add(kind === "whip" ? "is-whip" : "is-cut");
}

function showDirectorBanner({ kicker = "RACE CONTROL", headline = "LIVE TIMING", detail = "", color = "#d8ff51", duration = 3.1 } = {}) {
  if (!directorBanner) return;
  directorKicker.textContent = kicker;
  directorHeadline.textContent = headline;
  directorDetail.textContent = detail;
  directorBanner.style.setProperty("--banner-color", color);
  directorBanner.style.setProperty("--banner-duration", `${duration}s`);
  directorBanner.classList.remove("is-visible");
  void directorBanner.offsetWidth;
  directorBanner.classList.add("is-visible");
}

function queueDirectorMoment(moment) {
  if (cinematicLevel === "calm" && moment.kind === "specialist") return;
  const suppliedShots = moment.shots?.length ? moment.shots : [{ shot: "chase", duration: 3 }];
  const shots = cinematicLevel === "calm" ? suppliedShots.slice(0, 1) : suppliedShots;
  const takes = shots.map((shot, index) => ({
    ...shot,
    focus: shot.focus || moment.focus,
    secondary: shot.secondary || moment.secondary,
    priority: (moment.priority || 50) - index * 0.01,
    kicker: index === 0 ? moment.kicker : null,
    headline: index === 0 ? moment.headline : null,
    detail: index === 0 ? moment.detail : null,
    kind: moment.kind
  }));
  if (["upgrade", "specialist"].includes(moment.kind)) {
    directorQueue = directorQueue.filter((take) => !["upgrade", "specialist"].includes(take.kind));
  }
  if (moment.kind === "lead-change") directorQueue = [];
  directorQueue.push(...takes);
  directorQueue.sort((a, b) => b.priority - a.priority);
  directorQueue = directorQueue.slice(0, cinematicLevel === "calm" ? 4 : 10);
  if (selectedCamera === "director") {
    const preemptDelay = moment.kind === "lead-change" ? 0.08 : cinematicLevel === "calm" ? 1.1 : cinematicLevel === "maximum" ? 0.05 : 0.12;
    directorNextSwitch = Math.min(directorNextSwitch || Infinity, raceClock() + preemptDelay);
  }
}

function raceOrder() {
  return (currentRace.racers || []).filter((racer) => racer.active).sort((a, b) => b.score - a.score || COMPANY_ORDER.indexOf(a.key) - COMPANY_ORDER.indexOf(b.key));
}

function closestBattle(order) {
  if (order.length < 2) return null;
  let best = null;
  for (let i = 0; i < order.length - 1; i++) {
    const a = order[i];
    const b = order[i + 1];
    const visualGap = Math.abs((cars.get(a.key)?.userData.currentT || 0) - (cars.get(b.key)?.userData.currentT || 0));
    const scoreGap = Math.abs(a.score - b.score);
    const weight = visualGap * 100 + scoreGap * 0.35;
    if (!best || weight < best.weight) best = { a, b, visualGap, scoreGap, weight, position: i + 1 };
  }
  return best;
}

function scheduledDirectorTake() {
  const order = raceOrder();
  if (!order.length) return { shot: "drone", focus: null, duration: 2.5, cut: "hard" };
  const leader = order[0];
  const challenger = order[1] || leader;
  const battle = closestBattle(order);
  const phase = currentRace.progress || 0;
  const rotation = directorIndex++;
  const nonLeaders = order.filter((racer) => racer.key !== leader.key);
  const leastShown = [...(nonLeaders.length ? nonLeaders : order)].sort((a, b) => (lastShownAt.get(a.key) || -Infinity) - (lastShownAt.get(b.key) || -Infinity))[0];
  const candidate = rotation % 3 === 0 ? leader : leastShown;
  const gap = Math.max(0, leader.score - challenger.score);
  const leaderDetail = `${leader.model} · ${Math.round(leader.score)} Frontier Pace`;
  const contenderDetail = `P${order.indexOf(candidate) + 1} · ${candidate.model} · ${Math.round(candidate.score)} pace`;

  const early = [
    { shot: "drone", focus: leader.key, duration: 3.0, kicker: "FIELD VIEW", headline: `${leader.name} CONTROLS THE RACE`, detail: leaderDetail },
    { shot: "chase", focus: leader.key, duration: 3.1, kicker: "RACE LEADER", headline: `${leader.name} · P1`, detail: leaderDetail },
    { shot: "trackside", focus: candidate.key, duration: 2.8, kicker: "CAR WATCH", headline: `${candidate.name} ENTERS THE FRAME`, detail: contenderDetail },
    { shot: "front", focus: leader.key, duration: 2.7, kicker: "LEADER CAM", headline: `${leader.name} FROM THE FRONT`, detail: `Gap to P2 · ${gap.toFixed(1)} pace` }
  ];
  const middle = [
    { shot: "battle", focus: battle?.a.key || leader.key, secondary: battle?.b.key || challenger.key, duration: 3.3, kicker: `BATTLE FOR P${battle?.position || 1}`, headline: `${battle?.a.name || leader.name} vs ${battle?.b.name || challenger.name}`, detail: `${(battle?.scoreGap ?? gap).toFixed(1)} pace between them` },
    { shot: "cockpit", focus: candidate.key, duration: 2.65, kicker: "ONBOARD", headline: `RIDE WITH ${candidate.name}`, detail: contenderDetail },
    { shot: "low", focus: leader.key, duration: 2.55, kicker: "LOW CAM", headline: `${leader.name} ATTACKS THE KERB`, detail: leaderDetail },
    { shot: "crane", focus: challenger.key, duration: 3.0, kicker: "CHASING P1", headline: `${challenger.name} ON THE ATTACK`, detail: `P2 · ${challenger.model} · gap ${gap.toFixed(1)}` },
    { shot: "chase", focus: candidate.key, duration: 2.9, kicker: candidate.key === leader.key ? "RACE LEADER" : "CONTENDER WATCH", headline: `${candidate.name} · P${order.indexOf(candidate) + 1}`, detail: contenderDetail },
    { shot: "trackside", focus: leader.key, duration: 2.8, kicker: "TRACKSIDE", headline: `${leader.name} FLASHES PAST`, detail: leaderDetail },
    { shot: "orbit", focus: candidate.key, duration: 3.2, kicker: "HELICOPTER", headline: `FOLLOWING ${candidate.name}`, detail: contenderDetail },
    { shot: "front", focus: challenger.key, duration: 2.55, kicker: "P2 CAMERA", headline: `${challenger.name} CLOSES IN`, detail: `Gap to leader · ${gap.toFixed(1)} pace` }
  ];
  const late = [
    { shot: "battle", focus: leader.key, secondary: challenger.key, duration: 3.2, kicker: "FRONTIER FIGHT", headline: `${leader.name} vs ${challenger.name}`, detail: `P1 gap · ${gap.toFixed(1)} pace` },
    { shot: "cockpit", focus: leader.key, duration: 2.65, kicker: "LEADER ONBOARD", headline: `INSIDE ${leader.name}`, detail: leaderDetail },
    { shot: "finishline", focus: leader.key, duration: 3.0, kicker: "FINISH COMPLEX", headline: `${leader.name} APPROACHES THE LINE`, detail: leaderDetail },
    { shot: "chase", focus: challenger.key, duration: 2.8, kicker: "LAST CHARGE", headline: `${challenger.name} KEEPS PUSHING`, detail: `P2 · ${challenger.model}` },
    { shot: "drone", focus: leader.key, duration: 3.1, kicker: "AERIAL", headline: "THE FRONTIER ORDER", detail: order.map((r, i) => `P${i + 1} ${r.name}`).join(" · ") }
  ];
  const bank = phase < 0.18 ? early : phase > 0.84 ? late : middle;
  return { ...bank[rotation % bank.length], cut: rotation % 3 === 2 ? "whip" : "hard" };
}

function setActualShot(shot, force = false) {
  if (!force && actualShot === shot) return;
  actualShot = shot;
  tracksideReady = false;
  finishlineReady = false;
  updateCameraReadout();
}

function directorPriorityFor(take) {
  if (!take) return DIRECTOR_PRIORITY.scheduled;
  if (["predicted-pass", "pass-battle", "pass-complete", "lead-change"].includes(take.kind)) return DIRECTOR_PRIORITY.pass;
  if (take.kind === "stunt") return DIRECTOR_PRIORITY.stunt;
  if (["upgrade", "specialist"].includes(take.kind)) return DIRECTOR_PRIORITY.milestone;
  if (take.kind === "finish") return DIRECTOR_PRIORITY.finish;
  return take.lockPriority || take.priority || DIRECTOR_PRIORITY.scheduled;
}

function directorLockActive() {
  if (directorLock.owner && raceClock() >= directorLock.until) directorLock = { owner: null, priority: 0, until: 0 };
  return Boolean(directorLock.owner);
}

function acquireDirectorLock(owner, priority, duration) {
  directorLockActive();
  if (!directorLock.owner || priority >= directorLock.priority) {
    directorLock = { owner, priority, until: raceClock() + Math.max(0.1, duration) };
    return true;
  }
  return false;
}

function releaseDirectorLock(owner) {
  if (!owner || directorLock.owner === owner) directorLock = { owner: null, priority: 0, until: 0 };
}

function applyDirectorTake(take, force = false) {
  if (!take) return false;
  const cinema = CINEMATIC_LEVELS[cinematicLevel];
  const effectiveDuration = (take.duration || 3) * cinema.duration;
  const takePriority = directorPriorityFor(take);
  if (directorLockActive() && takePriority < directorLock.priority) return false;
  if (["predicted-pass", "pass-battle", "pass-complete", "lead-change"].includes(take.kind)) acquireDirectorLock("pass", DIRECTOR_PRIORITY.pass, effectiveDuration);
  else if (take.kind === "stunt") acquireDirectorLock("stunt", DIRECTOR_PRIORITY.stunt, effectiveDuration);
  else if (take.kind === "finish") acquireDirectorLock("finish", DIRECTOR_PRIORITY.finish, effectiveDuration);
  directorFocus = take.focus || currentRace.leader || raceOrder()[0]?.key || null;
  directorSecondary = take.secondary || null;
  if (directorFocus) lastShownAt.set(directorFocus, raceClock());
  if (directorSecondary) lastShownAt.set(directorSecondary, raceClock());
  directorCutCount += 1;
  setActualShot(take.shot || "chase", true);
  cameraSnapPending = true;
  directorNextSwitch = raceClock() + effectiveDuration;
  const requestedCut = take.cut || (force ? "hard" : "whip");
  triggerCameraCut(!cinema.whip && requestedCut === "whip" ? "hard" : requestedCut);
  const eventBanner = ["lead-change", "upgrade", "specialist", "predicted-pass", "pass-battle", "pass-complete"].includes(take.kind);
  if (take.headline && (cinema.banners === "all" || eventBanner)) {
    const color = COMPANY_META[directorFocus]?.color || "#d8ff51";
    showDirectorBanner({ kicker: take.kicker, headline: take.headline, detail: take.detail, color, duration: Math.min(effectiveDuration, 3.4) });
  }
  updateFocusReadout();
  updateCameraReadout();
  return true;
}

function chooseDirectorShot(force = false) {
  if (directorLockActive() && !force) return false;
  const take = directorQueue.length ? directorQueue.shift() : scheduledDirectorTake();
  return applyDirectorTake(take, force);
}

function setCinematicLevel(level) {
  if (!CINEMATIC_LEVELS[level]) return;
  cinematicLevel = level;
  stage.dataset.cinematic = level;
  const select = document.getElementById("cinematicLevel");
  if (select) select.value = level;
  updateCameraReadout();
  showDirectorBanner({
    kicker: "DIRECTOR SETTING",
    headline: `${CINEMATIC_LEVELS[level].label} MODE`,
    detail: level === "calm" ? "Longer shots · event graphics only" : level === "maximum" ? "Faster cuts · dramatic rigs · subtle camera vibration" : "Balanced broadcast pacing and full race graphics",
    color: "#d8ff51",
    duration: 2.6
  });
  if (selectedCamera === "director") directorNextSwitch = raceClock() + 0.25;
}

function setCameraMode(mode) {
  if (!CAMERA_NAMES[mode]) return;
  selectedCamera = mode;
  document.querySelectorAll("[data-camera]").forEach((button) => button.classList.toggle("is-active", button.dataset.camera === mode));
  if (mode === "director") {
    directorFocus = currentRace.leader || raceOrder()[0]?.key || directorFocus;
    directorNextSwitch = raceClock();
    if (activeStunt) updateHeroPhase(true);
    else if (activePass) {
      applyDirectorTake({
        shot: activePass.phase === "side-by-side" ? "battle" : "chase",
        focus: activePass.passer,
        secondary: activePass.target,
        duration: 1.4,
        cut: "hard",
        kind: activePass.phase === "side-by-side" ? "pass-battle" : "predicted-pass"
      }, true);
    } else chooseDirectorShot(true);
  } else {
    focusCompany = focusCompany || currentRace.leader || raceOrder()[0]?.key || null;
    setActualShot(mode, true);
    cameraSnapPending = true;
    triggerCameraCut("hard");
    updateFocusReadout();
  }
  updateCameraReadout();
}

function updateCameraReadout() {
  if (!cameraShotLabel) return;
  cameraShotLabel.textContent = selectedCamera === "director"
    ? `AUTO ${CINEMATIC_LEVELS[cinematicLevel].label} · CUT ${String(directorCutCount).padStart(2, "0")} · ${CAMERA_NAMES[actualShot]}`
    : CAMERA_NAMES[actualShot];
}

function updateCamera(dt) {
  if (selectedCamera === "director" && active && running && raceClock() >= directorNextSwitch && !finishMode && !activePass && !activeStunt && !directorLockActive()) chooseDirectorShot();
  const focus = activeFocusCar();
  if (!focus) {
    desiredCamera.set(-92, 18, 33);
    desiredLook.set(-82, 0, 0);
    camera.position.copy(desiredCamera);
    cameraLook.copy(desiredLook);
    camera.lookAt(cameraLook);
    return;
  }

  const secondary = activeSecondaryCar(focus);
  const shot = actualShot;
  const t = focus.userData.currentT;
  const point = circuitCurve.getPointAt(t);
  const tangent = circuitCurve.getTangentAt(t).normalize();
  const side = tempB.set(-tangent.z, 0, tangent.x).normalize();
  const carPos = focus.position;
  let targetFov = 55;

  if (shot === "chase") {
    desiredCamera.copy(carPos).addScaledVector(tangent, -11.5).addScaledVector(side, 1.4).add(new THREE.Vector3(0, 4.5, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, 10).add(new THREE.Vector3(0, 1.1, 0));
    targetFov = 64 + clamp(Math.abs(focus.userData.velocity) * 90, 0, 8);
  } else if (shot === "cockpit") {
    desiredCamera.copy(carPos).addScaledVector(tangent, 0.65).add(new THREE.Vector3(0, 1.52, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, 24).add(new THREE.Vector3(0, 1.0, 0));
    targetFov = 74;
  } else if (shot === "front") {
    desiredCamera.copy(carPos).addScaledVector(tangent, 10.5).addScaledVector(side, -0.8).add(new THREE.Vector3(0, 2.7, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, -2).add(new THREE.Vector3(0, 0.9, 0));
    targetFov = 60;
  } else if (shot === "low") {
    desiredCamera.copy(carPos).addScaledVector(tangent, -3.8).addScaledVector(side, 6.4).add(new THREE.Vector3(0, 0.85, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, 4).add(new THREE.Vector3(0, 0.65, 0));
    targetFov = 68;
  } else if (shot === "battle" && secondary) {
    const midpoint = tempC.copy(carPos).add(secondary.position).multiplyScalar(0.5);
    desiredCamera.copy(midpoint).addScaledVector(side, 13.5).addScaledVector(tangent, -2).add(new THREE.Vector3(0, 4.2, 0));
    desiredLook.copy(midpoint).addScaledVector(tangent, 3).add(new THREE.Vector3(0, 0.9, 0));
    targetFov = 58;
  } else if (shot === "crane") {
    desiredCamera.copy(carPos).addScaledVector(side, 15).addScaledVector(tangent, 5).add(new THREE.Vector3(0, 13.5, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, 2).add(new THREE.Vector3(0, 0.8, 0));
    targetFov = 49;
  } else if (shot === "drone") {
    desiredCamera.copy(carPos).addScaledVector(tangent, -4).add(new THREE.Vector3(0, 38, 0));
    desiredLook.copy(carPos).addScaledVector(tangent, 3);
    targetFov = 50;
  } else if (shot === "trackside") {
    if (!tracksideReady) {
      tracksideAnchor.copy(point).addScaledVector(side, 18).addScaledVector(tangent, 9).add(new THREE.Vector3(0, 4.3, 0));
      tracksideReady = true;
    }
    desiredCamera.copy(tracksideAnchor);
    desiredLook.copy(carPos).add(new THREE.Vector3(0, 1.1, 0));
    targetFov = 44;
  } else if (shot === "finishline") {
    if (!finishlineReady) {
      const finishPoint = circuitCurve.getPointAt(0.976);
      const finishTangent = circuitCurve.getTangentAt(0.976).normalize();
      const finishSide = tempD.set(-finishTangent.z, 0, finishTangent.x).normalize();
      finishlineAnchor.copy(finishPoint).addScaledVector(finishSide, 17).addScaledVector(finishTangent, 4).add(new THREE.Vector3(0, 5.4, 0));
      finishlineReady = true;
    }
    desiredCamera.copy(finishlineAnchor);
    desiredLook.copy(carPos).add(new THREE.Vector3(0, 1.1, 0));
    targetFov = 42;
  } else {
    const orbitRadius = finishMode ? 24 : 18;
    const angle = elapsed * (finishMode ? 0.38 : 0.22);
    desiredCamera.copy(carPos).add(new THREE.Vector3(Math.cos(angle) * orbitRadius, finishMode ? 13 : 10, Math.sin(angle) * orbitRadius));
    desiredLook.copy(carPos).add(new THREE.Vector3(0, 1, 0));
    targetFov = 53;
  }

  const shake = running && ["chase", "cockpit", "front", "low", "battle"].includes(shot)
    ? CINEMATIC_LEVELS[cinematicLevel].shake
    : 0;
  if (shake) {
    desiredCamera.addScaledVector(side, Math.sin(elapsed * 37) * shake);
    desiredCamera.y += Math.sin(elapsed * 53) * shake * 0.55;
  }

  // Broadcast cameras are rigid rigs: a cut changes only the viewpoint, never
  // the cars. Avoiding camera interpolation removes the optical rubber-band pull.
  camera.position.copy(desiredCamera);
  cameraLook.copy(desiredLook);
  camera.fov = targetFov;
  cameraSnapPending = false;
  camera.updateProjectionMatrix();
  camera.lookAt(cameraLook);

  cars.forEach((car) => {
    const showPlate = Boolean(car.userData.active && car.visible);
    if (car.userData.label) car.userData.label.visible = showPlate;
    if (car.userData.labelStalk) car.userData.labelStalk.visible = showPlate;
  });
}

function updateFocusReadout() {
  if (!focusReadout) return;
  const key = (selectedCamera === "director" ? directorFocus : focusCompany) || currentRace.leader;
  const racer = currentRace.racers?.find((item) => item.key === key);
  const meta = COMPANY_META[key];
  if (!meta || !racer) {
    focusReadout.querySelector("b").textContent = "LEADER";
    return;
  }
  focusReadout.style.setProperty("--follow-color", meta.color);
  focusReadout.querySelector("b").textContent = `${meta.name} · ${Math.round(racer.score)}`;
}

function boost(company, detail = {}) {
  const car = cars.get(company);
  if (!car) return;
  car.userData.boost = detail.delta > 0 ? 2.8 : 1.2;
  const racer = currentRace.racers?.find((item) => item.key === company);
  if (selectedCamera === "director") {
    const isUpgrade = detail.delta > 0;
    queueDirectorMoment({
      priority: isUpgrade ? 88 : 72,
      kind: isUpgrade ? "upgrade" : "specialist",
      focus: company,
      secondary: currentRace.leader !== company ? currentRace.leader : raceOrder()[1]?.key,
      shots: isUpgrade
        ? [
            { shot: "low", duration: 2.25, cut: "hard" },
            { shot: "chase", duration: 2.55, cut: "whip" },
            { shot: "cockpit", duration: 2.15, cut: "hard" }
          ]
        : [
            { shot: "trackside", duration: 2.35, cut: "hard" },
            { shot: "crane", duration: 2.55, cut: "whip" }
          ],
      kicker: isUpgrade ? "UPGRADE DEPLOYED" : "SPECIALIST RELEASE",
      headline: `${COMPANY_META[company].name} · ${detail.model || racer?.model || "NEW MODEL"}`,
      detail: isUpgrade ? `Frontier Pace +${Math.round(detail.delta)} · now ${Math.round(detail.score || racer?.score || 0)}` : `${detail.model || racer?.model || "New model"} joins the research timeline`
    });
  } else {
    focusCompany = company;
    updateFocusReadout();
  }
}

function setRunning(value) {
  running = Boolean(value);
  if (running && selectedCamera === "director" && active) directorNextSwitch = Math.min(directorNextSwitch || Infinity, raceClock() + 0.35);
}

function activate() {
  active = true;
  resizeRenderer();
  cameraSnapPending = true;
  if (selectedCamera === "director") {
    directorFocus = currentRace.leader || raceOrder()[0]?.key || null;
    directorNextSwitch = raceClock() + 0.18;
    showDirectorBanner({ kicker: "BROADCAST CONTROL", headline: "AUTO DIRECTOR ONLINE", detail: "Watching the leader, closest battle, upgrades and overtakes", color: "#d8ff51", duration: 2.8 });
  }
}

function deactivate() {
  if (replayState) endReplay({ cancelled: true });
  active = false;
}

function reset() {
  if (replayState) endReplay({ cancelled: true });
  clearTimeout(autoReplayTimer);
  replayBuffer.length = 0;
  replayCaptureAccumulator = 0;
  replayWallTime = 0;
  if (replayButton) replayButton.disabled = true;
  finishMode = false;
  finishWinner = null;
  directorQueue = [];
  directorLock = { owner: null, priority: 0, until: 0 };
  directorCutCount = 0;
  directorIndex = 0;
  directorFocus = null;
  directorSecondary = null;
  lastLeader = null;
  lastLeaderScore = 0;
  pendingLeadChange = null;
  activePass = null;
  passCooldown.clear();
  stuntQueue = [];
  stuntCooldown.clear();
  endActiveStunt(false);
  stuntFramework?.hide();
  physicalLeaderKey = null;
  COMPANY_ORDER.forEach((key) => lastShownAt.set(key, -Infinity));
  cars.forEach((car, key) => {
    car.userData.currentT = 0.012;
    car.userData.targetT = 0.012;
    car.userData.seasonT = 0.012;
    car.userData.lastSeasonT = 0.012;
    car.userData.currentGap = 0;
    car.userData.targetGap = 0;
    car.userData.velocity = 0;
    car.userData.boost = 0;
    car.visible = false;
    placeCar(car, 0.012, COMPANY_META[key].lane);
  });
  focusCompany = null;
  if (selectedCamera === "director") {
    setActualShot("drone", true);
    directorNextSwitch = raceClock() + 0.2;
    cameraSnapPending = true;
  }
}

function finish(winner) {
  const winnerKeys = (Array.isArray(winner) ? winner : [winner]).filter((key) => COMPANY_META[key]);
  const primaryWinner = winnerKeys[0];
  finishMode = true;
  finishWinner = winnerKeys;
  activePass = null;
  pendingLeadChange = null;
  stuntQueue = [];
  endActiveStunt(false);
  acquireDirectorLock("finish", DIRECTOR_PRIORITY.finish, 4.2);
  focusCompany = primaryWinner;
  directorFocus = primaryWinner;
  winnerKeys.forEach((key) => { const car = cars.get(key); if (car) car.userData.boost = 3; });
  setActualShot("finishline", true);
  cameraSnapPending = true;
  triggerCameraCut("hard");
  const deadHeat = winnerKeys.length > 1;
  showDirectorBanner({
    kicker: "CHEQUERED FLAG",
    headline: deadHeat ? `DEAD HEAT · ${winnerKeys.map((key) => COMPANY_META[key].name).join(" / ")}` : `${COMPANY_META[primaryWinner].name} WINS THE MODEL GP`,
    detail: deadHeat ? winnerKeys.map((key) => currentRace.racers?.find((r) => r.key === key)?.model).filter(Boolean).join(" · ") : currentRace.racers?.find((r) => r.key === primaryWinner)?.model || "Current frontier leader",
    color: COMPANY_META[primaryWinner].color,
    duration: 3.4
  });
  updateCameraReadout();
  updateFocusReadout();
  window.setTimeout(() => {
    if (!finishMode) return;
    setActualShot("orbit", true);
    cameraSnapPending = true;
    triggerCameraCut("hard");
  }, 1250);
}

function cycleCamera() {
  const current = selectedCamera === "director" ? actualShot : selectedCamera;
  const index = MANUAL_CAMERAS.indexOf(current);
  setCameraMode(MANUAL_CAMERAS[(index + 1) % MANUAL_CAMERAS.length]);
}

function toggleDirector() {
  setCameraMode(selectedCamera === "director" ? "chase" : "director");
}

function cycleFocus() {
  const available = currentRace.racers?.filter((r) => r.active).map((r) => r.key) || [];
  if (!available.length) return;
  const current = selectedCamera === "director" ? directorFocus : focusCompany;
  const index = available.indexOf(current);
  const next = available[(index + 1) % available.length];
  if (selectedCamera === "director") {
    applyDirectorTake({
      shot: "chase",
      focus: next,
      duration: 3.2,
      cut: "hard",
      kicker: "MANUAL TAKE",
      headline: `FOLLOWING ${COMPANY_META[next].name}`,
      detail: currentRace.racers.find((r) => r.key === next)?.model || "Selected car"
    }, true);
  } else {
    focusCompany = next;
    cameraSnapPending = true;
    triggerCameraCut("hard");
    updateFocusReadout();
  }
}

function drawTrackMap() {
  if (!mapCtx || !circuitCurve) return;
  const width = mapCanvas.width;
  const height = mapCanvas.height;
  mapCtx.clearRect(0, 0, width, height);
  const sampled = [];
  for (let i = 0; i <= 120; i++) sampled.push(circuitCurve.getPointAt(i / 120));
  const minX = Math.min(...sampled.map((p) => p.x));
  const maxX = Math.max(...sampled.map((p) => p.x));
  const minZ = Math.min(...sampled.map((p) => p.z));
  const maxZ = Math.max(...sampled.map((p) => p.z));
  const scale = Math.min((width - 22) / (maxX - minX), (height - 16) / (maxZ - minZ));
  const tx = (x) => 11 + (x - minX) * scale;
  const ty = (z) => height - 8 - (z - minZ) * scale;
  mapCtx.lineCap = "round";
  mapCtx.lineJoin = "round";
  mapCtx.strokeStyle = "rgba(238,242,232,.18)";
  mapCtx.lineWidth = 9;
  mapCtx.beginPath();
  sampled.forEach((p, i) => i ? mapCtx.lineTo(tx(p.x), ty(p.z)) : mapCtx.moveTo(tx(p.x), ty(p.z)));
  mapCtx.stroke();
  mapCtx.strokeStyle = "rgba(238,242,232,.65)";
  mapCtx.lineWidth = 1.5;
  mapCtx.stroke();

  cars.forEach((car, key) => {
    if (!car.visible) return;
    const p = circuitCurve.getPointAt(car.userData.currentT);
    mapCtx.fillStyle = COMPANY_META[key].color;
    mapCtx.shadowColor = COMPANY_META[key].color;
    mapCtx.shadowBlur = 8;
    mapCtx.beginPath();
    mapCtx.arc(tx(p.x), ty(p.z), key === currentRace.leader ? 4.6 : 3.2, 0, Math.PI * 2);
    mapCtx.fill();
    mapCtx.shadowBlur = 0;
  });
}

function animate() {
  renderHandle = requestAnimationFrame(animate);
  const rawDt = Math.min(clock.getDelta(), 0.5);
  const dt = Math.min(rawDt, 0.05);
  replayWallTime += rawDt;
  elapsed += dt;
  if (!initialized) return;
  if (replayState) {
    updateReplay(rawDt);
  } else {
    updateCars(dt);
    updateCamera(dt);
    captureReplayFrame(rawDt);
  }
  if (active) {
    if (!replayState) drawTrackMap();
    renderer.render(scene, camera);
  }
}

function bindCameraControls() {
  document.querySelectorAll("[data-camera]").forEach((button) => {
    button.addEventListener("click", () => setCameraMode(button.dataset.camera));
  });
  document.getElementById("cinematicLevel")?.addEventListener("change", (event) => setCinematicLevel(event.target.value));
  stuntToggle?.addEventListener("click", () => toggleStunts());
  replayButton?.addEventListener("click", () => replayState ? endReplay({ cancelled: true }) : startReplay("LAST FIVE SECONDS"));
}

function init() {
  try {
    makeRenderer();
    makeScene();
    makeCurve();
    createTrack();
    stuntFramework = new window.MGPStuntFramework.StuntFramework({ THREE, scene, curve: circuitCurve });
    createCars();
    bindCameraControls();
    updateStuntToggleUI();
    if (replayButton && (reducedMotion || compactDevice)) {
      replayButton.disabled = true;
      replayButton.title = "Replay is disabled in reduced-motion or low-power mode";
    }
    stage.dataset.cinematic = cinematicLevel;
    resizeRenderer();
    setCameraMode("director");
    initialized = true;
    loading?.classList.add("is-ready");
    const observer = new ResizeObserver(resizeRenderer);
    observer.observe(stage);
    window.addEventListener("resize", resizeRenderer);
    animate();

    window.mgp3d = {
      updateRace,
      boost,
      setRunning,
      activate,
      deactivate,
      reset,
      finish,
      cycleCamera,
      toggleDirector,
      cycleFocus,
      setCamera: setCameraMode,
      setCinematicLevel,
      startReplay,
      toggleReplay: () => replayState ? endReplay({ cancelled: true }) : startReplay("MANUAL REPLAY"),
      cancelReplay: () => endReplay({ cancelled: true }),
      getReplayState: () => replayState ? { active: true, reason: replayState.reason, progress: replayState.playhead / Math.max(.001, replayState.lastTime - replayState.firstTime), frames: replayState.frames.length } : { active: false, frames: replayBuffer.length },
      performStunt,
      toggleStunts,
      setStuntsEnabled,
      getStuntState: () => ({
        enabled: stuntsEnabled,
        active: activeStunt ? { ...activeStunt, primitive: stuntFramework?.activePrimitive?.name || null } : null,
        queued: stuntQueue.length,
        queue: stuntQueue.map((item) => ({ company: item.company, type: item.type, priority: item.priority, expiresAt: item.expiresAt }))
      }),
      getPrimitiveState: () => ({ activeType: stuntFramework?.activeType || null, activePrimitive: stuntFramework?.activePrimitive?.name || null, difficulty: stuntFramework?.difficulty ?? null }),
      getPhysicalLeader: () => physicalLeaderKey,
      getDirectorState: () => ({
        activePass: activePass ? { ...activePass } : null,
        pendingLeadChange: pendingLeadChange ? { ...pendingLeadChange } : null,
        focus: directorFocus,
        shot: actualShot,
        lock: { ...directorLock }
      }),
      getTelemetry: () => Object.fromEntries([...cars.entries()].map(([key, car]) => [key, {
        active: car.userData.active,
        position: car.userData.currentT,
        target: car.userData.targetT,
        season: car.userData.seasonT,
        gap: car.userData.currentGap
      }]))
    };
    window.dispatchEvent(new Event("mgp3d-ready"));
  } catch (error) {
    console.error("Model Grand Prix 3D failed to initialize", error);
    if (loading) {
      loading.innerHTML = `<b>3D RENDERER UNAVAILABLE</b><small>${error.message || "Your browser could not start WebGL."}</small>`;
    }
  }
}

init();
