function createLaneMarks() {
  const geometry = new THREE.BoxGeometry(2.35, 0.035, 0.085);
  const material = new THREE.MeshBasicMaterial({ color: 0xe8eee5, transparent: true, opacity: 0.72 });
  const offsets = [-2.75, 2.75];
  const count = 58 * offsets.length;
  const mesh = new THREE.InstancedMesh(geometry, material, count);
  let index = 0;
  offsets.forEach((offset) => {
    for (let i = 0; i < 58; i++) {
      const t = 0.012 + i / 58 * 0.974;
      placeAlong(mesh, t, offset, 0.10);
      tempMatrix.compose(mesh.position, mesh.quaternion, new THREE.Vector3(1, 1, 1));
      mesh.setMatrixAt(index++, tempMatrix);
    }
  });
  mesh.instanceMatrix.needsUpdate = true;
  scene.add(mesh);
}

function createCurbs() {
  const geometry = new THREE.BoxGeometry(1.8, 0.16, 0.82);
  const red = new THREE.MeshStandardMaterial({ color: 0xe34231, roughness: 0.7 });
  const cream = new THREE.MeshStandardMaterial({ color: 0xf2ede0, roughness: 0.7 });
  const redMesh = new THREE.InstancedMesh(geometry, red, 184);
  const whiteMesh = new THREE.InstancedMesh(geometry, cream, 184);
  let redIndex = 0;
  let whiteIndex = 0;
  for (let i = 0; i < 184; i++) {
    const t = 0.004 + i / 184 * 0.992;
    [-9.02, 9.02].forEach((offset, sideIndex) => {
      const target = (i + sideIndex) % 2 === 0 ? redMesh : whiteMesh;
      placeAlong(target, t, offset, 0.09);
      tempMatrix.compose(target.position, target.quaternion, new THREE.Vector3(1, 1, 1));
      if (target === redMesh) redMesh.setMatrixAt(redIndex++, tempMatrix);
      else whiteMesh.setMatrixAt(whiteIndex++, tempMatrix);
    });
  }
  redMesh.count = redIndex;
  whiteMesh.count = whiteIndex;
  redMesh.instanceMatrix.needsUpdate = true;
  whiteMesh.instanceMatrix.needsUpdate = true;
  redMesh.receiveShadow = whiteMesh.receiveShadow = true;
  scene.add(redMesh, whiteMesh);
}

function createBarriers() {
  const geometry = new THREE.BoxGeometry(2.2, 0.7, 0.25);
  const material = new THREE.MeshStandardMaterial({ color: 0xbec4bd, roughness: 0.55, metalness: 0.45 });
  const countPerSide = 145;
  const mesh = new THREE.InstancedMesh(geometry, material, countPerSide * 2);
  for (let sideIndex = 0; sideIndex < 2; sideIndex++) {
    const offset = sideIndex === 0 ? -11.1 : 11.1;
    for (let i = 0; i < countPerSide; i++) {
      const t = i / (countPerSide - 1);
      placeAlong(mesh, t, offset, 0.35);
      tempMatrix.compose(mesh.position, mesh.quaternion, new THREE.Vector3(1, 1, 1));
      mesh.setMatrixAt(sideIndex * countPerSide + i, tempMatrix);
    }
  }
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  mesh.instanceMatrix.needsUpdate = true;
  scene.add(mesh);
}

